{"ts":1794562778727,"data":{"id":"default","name":"默认题库","title":"字谜闯关游戏","logo":"","pages":[{"key":"xiehouyu","name":"歇后语字谜","type":"xiehouyu","icon":"❓"},{"key":"gushi","name":"古诗字谜","type":"gushi","icon":"📜"},{"key":"caizi","name":"猜字字谜","type":"caizi","icon":"🔍"}],"background":"resource/background.png","levels":{"xiehouyu":[[{"q":"小葱拌豆腐","answers":["一清二白"],"distractors":["越来越香","乱七八糟","一青二白"]},{"q":"孔夫子搬家","answers":["净是输","尽是书"],"distractors":["越搬越远","都是书","搬不动"]},{"q":"外甥打灯笼","answers":["照旧","照舅"],"distractors":["照亮路","真热闹","找舅舅"]},{"q":"四月的冰河","answers":["开动了","开冻了"],"distractors":["融化了","结冰了","很冷"]},{"q":"隔着门缝吹喇叭","answers":["名声在外"],"distractors":["声音小","吹不动","不好听"]}],[{"q":"飞机上吹喇叭","answers":["想得高","响得高"],"distractors":["飞得高","声音大","听不见"]},{"q":"四两棉花","answers":["谈不上","弹不上"],"distractors":["很轻","弹不动","太轻了"]},{"q":"老虎拉车","answers":["谁敢"],"distractors":["跑得快","真威风","拉不动"]},{"q":"膝盖上钉掌","answers":["离题太远","离蹄太远"],"distractors":["很舒服","钉不稳","疼死了"]},{"q":"骑自行车下坡","answers":["睬都不睬","踩都不踩"],"distractors":["跑得快","很危险","不用力"]}],[{"q":"黄鼠狼给鸡拜年","answers":["没安好心"],"distractors":["很友好","送礼物","关心鸡"]},{"q":"竹篮打水","answers":["一场空"],"distractors":["装满水","很好玩","打水快"]},{"q":"泥菩萨过江","answers":["自身难保"],"distractors":["很厉害","会游泳","过江去"]},{"q":"八仙过海","answers":["各显神通"],"distractors":["坐船过","一起飞","本领大"]},{"q":"姜太公钓鱼","answers":["愿者上钩"],"distractors":["钓大鱼","钓不到","用直钩"]}],[{"q":"哑巴吃黄连","answers":["有苦说不出"],"distractors":["很好吃","很甜","苦死了"]},{"q":"擀面杖吹火","answers":["一窍不通"],"distractors":["很用力","吹得旺","吹不动"]},{"q":"骑驴看唱本","answers":["走着瞧"],"distractors":["慢慢看","真悠闲","边骑边看"]},{"q":"肉包子打狗","answers":["有去无回"],"distractors":["很好吃","狗吓跑","打狗用"]},{"q":"十五个吊桶打水","answers":["七上八下"],"distractors":["很平稳","打水快","忙不停"]}],[{"q":"芝麻开花","answers":["节节高"],"distractors":["朵朵开","很香","长得快"]},{"q":"骑驴找驴","answers":["昏了头"],"distractors":["找不到","真糊涂","骑错了"]},{"q":"大水冲了龙王庙","answers":["一家人不认一家人"],"distractors":["冲坏了","水太大了","神仙打架"]},{"q":"兔子尾巴","answers":["长不了"],"distractors":["很短小","很可爱","跑得快"]},{"q":"王婆卖瓜","answers":["自卖自夸"],"distractors":["瓜很甜","卖得好","很会卖"]}],[{"q":"鸡蛋碰石头","answers":["不自量力"],"distractors":["碎了","很勇敢","碰不破"]},{"q":"丈二和尚","answers":["摸不着头脑"],"distractors":["很高大","很厉害","找不到"]},{"q":"画蛇添足","answers":["多此一举"],"distractors":["更漂亮","画得好","很逼真"]},{"q":"井底青蛙","answers":["目光短浅"],"distractors":["很自在","会跳高","看不见"]},{"q":"船到桥头","answers":["自然直"],"distractors":["过不去","撞上了","很危险"]}],[{"q":"猫哭耗子","answers":["假慈悲"],"distractors":["真伤心","很可怜","哭得响"]},{"q":"狗咬吕洞宾","answers":["不识好人心"],"distractors":["咬伤了","很凶","不认识"]},{"q":"铁公鸡","answers":["一毛不拔"],"distractors":["很坚硬","不生锈","很值钱"]},{"q":"热锅上的蚂蚁","answers":["团团转"],"distractors":["很烫","跑得快","很着急"]},{"q":"偷鸡不成","answers":["蚀把米"],"distractors":["被抓了","跑掉了","没偷到"]}],[{"q":"打开天窗","answers":["说亮话"],"distractors":["透气","看星星","很明亮"]},{"q":"赶鸭子上架","answers":["强人所难"],"distractors":["上不去","很费力","鸭子飞了"]},{"q":"麻雀虽小","answers":["五脏俱全"],"distractors":["飞得高","很可爱","叫得响"]},{"q":"老鼠过街","answers":["人人喊打"],"distractors":["跑得快","很害怕","偷偷溜"]},{"q":"三十六计","answers":["走为上计"],"distractors":["都很妙","很厉害","用计谋"]}]],"gushi":[[{"q":"解落三秋叶，能开二月花。过江千尺浪，入竹万竿斜。","answers":["风"],"distractors":["雨","雪","雾"]},{"q":"远看山有色，近听水无声。春去花还在，人来鸟不惊。","answers":["画"],"distractors":["诗","景","画"]},{"q":"小时不识月，呼作白玉盘。又疑瑶台镜，飞在青云端。","answers":["月"],"distractors":["日","星","云"]},{"q":"床前明月光，疑是地上霜。举头望明月，低头思故乡。","answers":["月"],"distractors":["日","光","霜"]},{"q":"春眠不觉晓，处处闻啼鸟。夜来风雨声，花落知多少。","answers":["春"],"distractors":["夏","秋","冬"]}],[{"q":"锄禾日当午，汗滴禾下土。谁知盘中餐，粒粒皆辛苦。","answers":["米"],"distractors":["饭","粮","田"]},{"q":"鹅，鹅，鹅，曲项向天歌。白毛浮绿水，红掌拨清波。","answers":["鹅"],"distractors":["鸭","鸟","鹤"]},{"q":"松下问童子，言师采药去。只在此山中，云深不知处。","answers":["隐"],"distractors":["仙","道","山"]},{"q":"众鸟高飞尽，孤云独去闲。相看两不厌，只有敬亭山。","answers":["山"],"distractors":["云","鸟","亭"]},{"q":"白日依山尽，黄河入海流。欲穷千里目，更上一层楼。","answers":["楼"],"distractors":["山","河","日"]}],[{"q":"碧玉妆成一树高，万条垂下绿丝绦。不知细叶谁裁出，二月春风似剪刀。","answers":["柳"],"distractors":["杨","松","竹"]},{"q":"两个黄鹂鸣翠柳，一行白鹭上青天。窗含西岭千秋雪，门泊东吴万里船。","answers":["柳"],"distractors":["鸟","船","雪"]},{"q":"毕竟西湖六月中，风光不与四时同。接天莲叶无穷碧，映日荷花别样红。","answers":["荷"],"distractors":["莲","湖","花"]},{"q":"墙角数枝梅，凌寒独自开。遥知不是雪，为有暗香来。","answers":["梅"],"distractors":["雪","花","香"]},{"q":"待到重阳日，还来就菊花。","answers":["菊"],"distractors":["花","酒","日"]}],[{"q":"千山鸟飞绝，万径人踪灭。孤舟蓑笠翁，独钓寒江雪。","answers":["雪"],"distractors":["江","翁","鱼"]},{"q":"月落乌啼霜满天，江枫渔火对愁眠。姑苏城外寒山寺，夜半钟声到客船。","answers":["钟"],"distractors":["船","寺","月"]},{"q":"西塞山前白鹭飞，桃花流水鳜鱼肥。青箬笠，绿蓑衣，斜风细雨不须归。","answers":["鱼"],"distractors":["鸟","花","雨"]},{"q":"朝辞白帝彩云间，千里江陵一日还。两岸猿声啼不住，轻舟已过万重山。","answers":["舟"],"distractors":["山","云","猿"]},{"q":"故人西辞黄鹤楼，烟花三月下扬州。孤帆远影碧空尽，唯见长江天际流。","answers":["帆"],"distractors":["楼","江","船"]}],[{"q":"慈母手中线，游子身上衣。临行密密缝，意恐迟迟归。","answers":["母"],"distractors":["衣","线","子"]},{"q":"独在异乡为异客，每逢佳节倍思亲。遥知兄弟登高处，遍插茱萸少一人。","answers":["乡"],"distractors":["亲","节","山"]},{"q":"渭城朝雨浥轻尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。","answers":["酒"],"distractors":["柳","雨","客"]},{"q":"李白乘舟将欲行，忽闻岸上踏歌声。桃花潭水深千尺，不及汪伦送我情。","answers":["情"],"distractors":["潭","歌","船"]},{"q":"海内存知己，天涯若比邻。","answers":["友"],"distractors":["海","天","邻"]}],[{"q":"爆竹声中一岁除，春风送暖入屠苏。千门万户曈曈日，总把新桃换旧符。","answers":["年"],"distractors":["春","桃","符"]},{"q":"清明时节雨纷纷，路上行人欲断魂。借问酒家何处有，牧童遥指杏花村。","answers":["酒"],"distractors":["雨","村","花"]},{"q":"七夕今宵看碧霄，牵牛织女渡河桥。家家乞巧望秋月，穿尽红丝几万条。","answers":["桥"],"distractors":["月","星","河"]},{"q":"独在异乡为异客，每逢佳节倍思亲。遥知兄弟登高处，遍插茱萸少一人。","answers":["重"],"distractors":["节","亲","山"]},{"q":"去年元夜时，花市灯如昼。月上柳梢头，人约黄昏后。","answers":["灯"],"distractors":["月","花","夜"]}]],"caizi":[[{"q":"三个人看日出","answers":["春"],"distractors":["日","人","阳"]},{"q":"一口咬掉牛尾巴","answers":["告"],"distractors":["牛","口","尾"]},{"q":"山上还有山","answers":["出"],"distractors":["山","上","有"]},{"q":"十张口，一颗心","answers":["思"],"distractors":["十","口","心"]},{"q":"点点成金","answers":["全"],"distractors":["点","金","成"]}],[{"q":"四面都是山，山山都相连","answers":["田"],"distractors":["山","四","连"]},{"q":"一人腰上挂把弓","answers":["夷"],"distractors":["人","腰","弓"]},{"q":"一口咬定","answers":["交"],"distractors":["口","咬","定"]},{"q":"一斗米","answers":["料"],"distractors":["一","斗","米"]},{"q":"千里姻缘一线牵","answers":["重"],"distractors":["千","里","线"]}],[{"q":"十个哥哥","answers":["克"],"distractors":["十","个","哥"]},{"q":"小姑娘","answers":["妙"],"distractors":["小","姑","娘"]},{"q":"五十对耳朵","answers":["陌"],"distractors":["五","十","耳"]},{"q":"难分上下","answers":["卡"],"distractors":["难","分","上"]},{"q":"六十不足，八十有余","answers":["平"],"distractors":["六","八","十"]}],[{"q":"手提包","answers":["抱"],"distractors":["手","提","包"]},{"q":"半个月亮","answers":["胖"],"distractors":["半","个","月"]},{"q":"文武两全","answers":["斌"],"distractors":["文","武","全"]},{"q":"有人不是你我，有土能种庄稼，有水能养鱼虾","answers":["也"],"distractors":["人","土","水"]},{"q":"画时圆，写时方","answers":["日"],"distractors":["画","圆","方"]}],[{"q":"半青半紫","answers":["素"],"distractors":["半","青","紫"]},{"q":"秀才翘尾巴","answers":["秃"],"distractors":["秀","才","尾"]},{"q":"千里挑一，百里挑一","answers":["伯"],"distractors":["千","百","挑"]},{"q":"开门闻吠声","answers":["润"],"distractors":["开","门","吠"]},{"q":"令堂","answers":["诲"],"distractors":["令","堂","母"]}],[{"q":"志士献身在四方","answers":["思"],"distractors":["志","士","方"]},{"q":"一口吃掉牛尾巴","answers":["告"],"distractors":["口","吃","牛"]},{"q":"一木口中栽，非杏也非呆","answers":["困"],"distractors":["木","口","杏"]},{"q":"一点一横长，一撇到南洋","answers":["广"],"distractors":["点","横","撇"]},{"q":"十字对十字，太阳对月亮","answers":["朝"],"distractors":["十","太","月"]}],[{"q":"皇帝的衣服","answers":["袭"],"distractors":["皇","帝","衣"]},{"q":"守门员","answers":["闪"],"distractors":["守","门","员"]},{"q":"有人本领大，能在云上飘","answers":["会"],"distractors":["人","云","飘"]},{"q":"七人头上长了草","answers":["花"],"distractors":["七","人","草"]},{"q":"一加一","answers":["王"],"distractors":["一","加","+"]}],[{"q":"人有他则变大","answers":["一"],"distractors":["人","他","大"]},{"q":"人无信不立","answers":["言"],"distractors":["人","信","立"]},{"q":"八十八","answers":["米"],"distractors":["八","十","八"]},{"q":"刀出鞘","answers":["力"],"distractors":["刀","出","鞘"]},{"q":"十一点进厂","answers":["压"],"distractors":["十","一","厂"]}]]},"bgm":"resource/default_bgm","achievements":[{"id":"first-try","name":"首次尝试","desc":"完成任意一个关卡","type":"levels","target":1,"reward":2},{"id":"rookie","name":"初出茅庐","desc":"在字谜游戏中获得一次一等奖","type":"first","target":1,"reward":3},{"id":"riddle-master","name":"字谜大师","desc":"字谜全部22个关卡都获得一等奖","type":"first","target":22,"reward":75},{"id":"easter-egg","name":"彩色的蛋!","desc":"触发一个彩蛋","type":"easter","target":1,"reward":1,"scope":"global"},{"id":"vip-tricked","name":"你被骗了!","desc":"触发VIP彩蛋并点击链接","type":"vip","target":1,"reward":1,"scope":"global","hidden":true},{"id":"ten-levels","name":"渐入佳境","desc":"累计完成 10 个关卡","type":"levels","target":10,"reward":5},{"id":"all-levels","name":"全面通关","desc":"完成全部 22 个关卡","type":"levels","target":22,"reward":15},{"id":"eight-firsts","name":"崭露头角","desc":"累计获得 8 个一等奖","type":"first","target":8,"reward":8},{"id":"fifteen-firsts","name":"技压群雄","desc":"累计获得 15 个一等奖","type":"first","target":15,"reward":20},{"id":"points-50","name":"积分新贵","desc":"累计积分达到 50","type":"points","target":50,"reward":8,"scope":"global"},{"id":"points-150","name":"积分大亨","desc":"累计积分达到 150","type":"points","target":150,"reward":20,"scope":"global"},{"id":"points-300","name":"积分之王","desc":"累计积分达到 300","type":"points","target":300,"reward":40,"scope":"global"}],"shop":[{"id":"gu-ren-zhi-hui","name":"古人的智慧","desc":"每一级提升10%的概率让正确答案绿色闪烁","price":100,"maxLevel":5,"tier":"专属","icon":"📜","effect":"glint"},{"id":"time-hourglass","name":"时光沙漏","desc":"每一级增加1秒答题时间","price":80,"maxLevel":5,"tier":"专属","icon":"⏳","effect":"time"},{"id":"knowledge-fountain","name":"博闻强记","desc":"每一级增加10%通关获得的积分","price":120,"maxLevel":5,"tier":"专属","icon":"📚","effect":"points"},{"id":"ui-glass","name":"毛玻璃卡片","desc":"所有卡片与弹窗变为毛玻璃模糊效果","price":200,"maxLevel":0,"tier":"通用","icon":"🪟","effect":"ui-glass"},{"id":"ui-neon","name":"霓虹之光","desc":"标题与按钮散发霓虹光晕","price":150,"maxLevel":0,"tier":"通用","icon":"💡","effect":"ui-neon"},{"id":"ui-dark","name":"暗黑模式","desc":"切换为深色界面，护眼又酷炫","price":180,"maxLevel":0,"tier":"通用","icon":"🌙","effect":"ui-dark"},{"id":"ui-rainbow","name":"彩虹主题","desc":"主题色随时间循环渐变","price":300,"maxLevel":0,"tier":"通用","icon":"🌈","effect":"ui-rainbow"},{"id":"ui-font","name":"手写字体","desc":"全站使用手写风格字体","price":120,"maxLevel":0,"tier":"通用","icon":"✍️","effect":"ui-font"}]}}